# OpenCodeReview Manager — example environment.
# Copy to `.env` at the repo root and adjust. Every value is optional;
# defaults are sane for local use. No real credentials belong in this file —
# provider API keys are entered in the UI and stored in the OS keyring.

# --- network ---------------------------------------------------------------
# OCR_CC_HOST=127.0.0.1
# OCR_CC_PORT=8787

# --- paths -----------------------------------------------------------------
# Where the app keeps its database, job artifacts, worktrees, and sessions.
# Defaults to a per-user data directory when unset.
# OCR_CC_DATA_DIR=/path/to/data
# Extra roots the UI is allowed to browse for projects (path restrictions
# are off by default; enable to lock the app to specific directories).
# OCR_CC_PATH_RESTRICTIONS_ENABLED=false
# OCR_CC_ALLOWED_ROOTS=/path/to/workspaces

# --- executables -----------------------------------------------------------
# Custom path to the ocr binary (default: found on PATH).
# OCR_CC_OCR_EXECUTABLE=/usr/local/bin/ocr
# OCR_CC_GIT_EXECUTABLE=/usr/bin/git

# --- queue -----------------------------------------------------------------
# OCR_CC_GLOBAL_CONCURRENCY=1
# OCR_CC_PER_PROJECT_CONCURRENCY=1
# OCR_CC_DEFAULT_PROVIDER_CONCURRENCY=2

# --- webhooks ---------------------------------------------------------------
# OCR_CC_WEBHOOK_REQUIRE_HTTPS=true
# OCR_CC_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# --- logging ----------------------------------------------------------------
# OCR_CC_LOG_LEVEL=INFO
