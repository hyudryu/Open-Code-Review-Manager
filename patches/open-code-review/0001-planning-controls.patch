+// applyPlanningOverrides applies the --template / --plan-threshold /
+// --max-tokens template overrides requested on the command line. --plan-mode
+// does not mutate the template; it is passed to the agent at construction
+// time. The template is re-validated after overrides so an invalid custom
+// template fails fast before any LLM call.
+func applyPlanningOverrides(cc *commonContext, opts reviewOptions) error {
+	if opts.templatePath != "" {
+		custom, err := template.LoadFromFile(opts.templatePath)
+		if err != nil {
+			return fmt.Errorf("load custom template: %w", err)
+		}
+		if opts.maxTools > custom.MaxToolRequestTimes {
+			custom.MaxToolRequestTimes = opts.maxTools
+		}
+		cc.Template = custom
+	}
+	if opts.planThreshold > 0 {
+		cc.Template.PlanModeLineThreshold = opts.planThreshold
+	}
+	if opts.maxTokens > 0 {
+		cc.Template.MaxTokens = opts.maxTokens
+	}
+	if err := cc.Template.Validate(); err != nil {
+		return fmt.Errorf("invalid config: %w", err)
+	}
+	return nil
+}
