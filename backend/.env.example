# Copy to .env and adjust. NEVER commit real credentials.
# All variables are prefixed OCR_CC_ and map to app.core.config.Settings.

# Data directory (default: ~/.ocr-control-center)
OCR_CC_DATA_DIR=

# Bind address / port (localhost-only by default; do not expose without auth+TLS)
OCR_CC_HOST=127.0.0.1
OCR_CC_PORT=8787

# Restrict project registration to these roots (semicolon-separated). Empty = unrestricted.
OCR_CC_ALLOWED_ROOTS=
OCR_CC_PATH_RESTRICTIONS_ENABLED=false

# Custom OCR executable path (auto-detected from PATH when empty)
OCR_CC_OCR_EXECUTABLE=
# Custom Git executable path
OCR_CC_GIT_EXECUTABLE=

# Queue
OCR_CC_GLOBAL_CONCURRENCY=1
OCR_CC_PER_PROJECT_CONCURRENCY=1
OCR_CC_DEFAULT_PROVIDER_CONCURRENCY=2
OCR_CC_MAX_QUEUED_JOBS=200

# Retention
OCR_CC_ARTIFACT_RETENTION_DAYS=30
OCR_CC_KEEP_WORKTREES=false

# Timeouts (seconds)
OCR_CC_GIT_TIMEOUT_SECONDS=60
OCR_CC_GIT_FETCH_TIMEOUT_SECONDS=300
OCR_CC_OCR_PROBE_TIMEOUT_SECONDS=15
OCR_CC_OCR_PROCESS_TIMEOUT_SECONDS=86400

# Logging
OCR_CC_LOG_LEVEL=INFO

# Database URL override (default: sqlite+aiosqlite:///<data_dir>/ocrcc.db)
OCR_CC_DATABASE_URL=
